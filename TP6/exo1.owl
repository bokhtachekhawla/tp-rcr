<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/knowledge.owl"
         xmlns="http://example.org/knowledge.owl#">

<owl:Ontology rdf:about="http://example.org/knowledge.owl"/>

<owl:ObjectProperty rdf:about="#compose">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#est_correcte">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#genere">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#definie">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#est_un">
  <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#MODE">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LMODE">
  <rdfs:subClassOf rdf:resource="#MODE"/>
</owl:Class>

<owl:Class rdf:about="#GMODE">
  <rdfs:subClassOf rdf:resource="#MODE"/>
</owl:Class>

<owl:Class rdf:about="#LCLASSIC">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LNONCLASSIC">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LOGIC">
  <rdfs:subClassOf>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:someValuesFrom rdf:resource="#CONTRADICTIONS"/>
          <owl:onProperty rdf:resource="#genere"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#SEMANTIC"/>
      <owl:onProperty rdf:resource="#definie"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#SYNTAX"/>
      <owl:onProperty rdf:resource="#definie"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="#LANGUAGE"/>
      <owl:onProperty rdf:resource="#definie"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SYNTAX">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="#AXIOME"/>
      <owl:onProperty rdf:resource="#compose"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onClass rdf:resource="#RINFERENCE"/>
      <owl:onProperty rdf:resource="#compose"/>
      <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SEMANTIC">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:allValuesFrom rdf:resource="#RVALUATION"/>
      <owl:onProperty rdf:resource="#compose"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LANGUAGE">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ALPHABET">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#RREECRITURE">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#AXIOME">
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
      <owl:onProperty rdf:resource="#est_correcte"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#RINFERENCE">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#RVALUATION">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CONTRADICTIONS">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#LMODAL_CLASS">
  <rdf:type rdf:resource="#LNONCLASSIC"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LDEFAUT">
  <rdf:type rdf:resource="#LNONCLASSIC"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RBAYESIEN">
  <rdf:type rdf:resource="#GMODE"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#RSEMANTIQUE">
  <rdf:type rdf:resource="#GMODE"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#A4">
  <rdf:type rdf:resource="#AXIOME"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#LOGPRED">
  <rdf:type rdf:resource="#LCLASSIC"/>
  <compose rdf:resource="#A4"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#SYST_T">
  <rdf:type rdf:resource="#LNONCLASSIC"/>
  <compose rdf:resource="#A7"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#A7">
  <rdf:type rdf:resource="#AXIOME"/>
</owl:NamedIndividual>


</rdf:RDF>
